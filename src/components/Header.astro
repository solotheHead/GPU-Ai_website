---
import { site } from '../config/site';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="et-l et-l--header">
  <div class="et_builder_inner_content et_pb_gutters3">
    <div class="et_pb_section et_pb_section_0_tb_header nx-layout-section et_section_regular">
      <div class="et_pb_row et_pb_row_0_tb_header nx-layout-row">
        <div class="et_pb_column et_pb_column_4_4 et_pb_column_0_tb_header et_pb_css_mix_blend_mode_passthrough et-last-child">
          <div class="et_pb_module et_pb_code et_pb_code_0_tb_header nx-layout-code">
            <div class="et_pb_code_inner">
              <div class="nx-header" data-nx-header>
                <a class="nx-skip-link" href="#main-content">Skip to content</a>
                <div class="nx-container nx-header-inner">
                  <a class="nx-brand" href="/" aria-label={`${site.name} home`}>
                    <img src={site.logos.header} alt={site.name} width="160" height="52" decoding="async" />
                  </a>
                  <nav class="nx-language-switch nx-language-switch-3" aria-label="Language">
                    {site.languages.map((lang) => (
                      <a
                        href={lang.href}
                        lang={lang.code}
                        hreflang={lang.code}
                        data-nodex-language={lang.code}
                        aria-label={lang.aria}
                        aria-current={lang.code === 'en' ? 'true' : undefined}
                      >{lang.label}</a>
                    ))}
                  </nav>
                  <button class="nx-menu-toggle" type="button" aria-expanded="false" aria-controls="nx-primary-nav">
                    <span class="nx-menu-icon" aria-hidden="true"></span>
                    <span>Menu</span>
                  </button>
                  <nav id="nx-primary-nav" class="nx-nav" aria-label="Main navigation">
                    {site.nav.map((item) => (
                      <a
                        href={item.href}
                        aria-current={(item.href.replace(/\/$/, '') || '/') === current ? 'page' : undefined}
                      >{item.label}</a>
                    ))}
                    <a class="nx-button nx-nav-cta" href={site.cta.href}>
                      {site.cta.label} <span aria-hidden="true">↗</span>
                    </a>
                  </nav>
                </div>
              </div>
              <style is:inline>
                .nx-header .nx-brand { display: block; flex: 0 0 auto; width: 190px; max-width: none; }
                .nx-header .nx-brand img { display: block; width: 100%; max-width: none; height: auto; max-height: none; }
                @media (max-width: 767px) { .nx-header .nx-brand { width: 150px; } }
              </style>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
