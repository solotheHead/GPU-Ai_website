---
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  pageCss?: string[];
  /** slug used for /page-styles/{slug}.css */
  stylesSlug?: string;
}

const {
  title,
  description = '',
  bodyClass = 'nx-design nodex-lang-en et_divi_theme',
  pageCss = [],
  stylesSlug,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="nx-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={site.logos.favicon} />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2026/11/cropped-Interlocking-orange-N-favicon-180x180.png" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={site.logos.og} />
    <!-- Critical FOUC guard for mobile header (from original) -->
    <style is:inline>
      @media(max-width:980px){html.nx-js .nx-header:not(.nx-menu-ready):not(.is-open) .nx-nav{display:none}}
    </style>
    {site.styles.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    {pageCss.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    {stylesSlug && (
      <link rel="stylesheet" href={`/page-styles/${stylesSlug}.css`} />
    )}
  </head>
  <body class={bodyClass}>
    <div id="page-container">
      <div id="et-boc" class="et-boc">
        <Header />
        <div id="et-main-area">
          <slot />
        </div>
        <Footer />
      </div>
    </div>
    {site.scripts.map((src) => (
      <script src={src} is:inline></script>
    ))}
    <!-- Static form stub: display-only, no WordPress backend -->
    <script is:inline>
      (function () {
        function notice(form) {
          var existing = form.querySelector('.nx-form-stub-notice');
          if (existing) return;
          var el = document.createElement('p');
          el.className = 'nx-form-stub-notice';
          el.setAttribute('role', 'status');
          el.style.cssText = 'margin:16px 0;padding:12px 16px;background:#1a222c;border:1px solid #ef7d32;color:#f5f7fa;border-radius:8px;';
          el.textContent = 'Form not connected — this is a static Astro preview. Nothing was submitted.';
          form.prepend(el);
        }
        document.addEventListener('submit', function (e) {
          var form = e.target && e.target.closest && e.target.closest('form');
          if (!form) return;
          e.preventDefault();
          e.stopPropagation();
          notice(form);
        }, true);
      })();
    </script>
  </body>
</html>
